{
  "manifest_version": 3,
  "name": "Privacy Protector",
  "version": "1.0",
  "description": "A simple privacy extension popup UI.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "images/128.png"
  },
  "permissions": ["storage"],
  "action": {
  "default_popup": "popup.html",
  "default_icon": {
    "16": "images/16.png",
    "48": "images/48.png",
    "128": "images/128.png"
  }
}
}
